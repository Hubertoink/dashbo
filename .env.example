# Shared env (docker compose reads this)

# NOTE:
# - Copy this file to `.env` and adjust values.
# - Do not commit real secrets (JWT_SECRET, passwords, OAuth secrets).

# OpenWeatherMap
OWM_API_KEY=
OWM_LAT=49.4875
OWM_LON=8.4660
OWM_UNITS=metric
OWM_LANG=de

# Optional public base URL used in mail links (password reset, email verify)
# Example: https://dashbo.example.com
PUBLIC_APP_URL=

# Optional SMTP for password reset + email verification
# Common examples:
# - STARTTLS on 587: SMTP_SECURE=false, SMTP_REQUIRE_TLS=true
# - SMTPS on 465:    SMTP_SECURE=true,  SMTP_REQUIRE_TLS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DashbO <noreply@example.com>

# Backend
BACKEND_PORT=3000
CORS_ORIGIN=http://localhost:8080
JWT_SECRET=change-me
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me
BOOTSTRAP_ADMIN_NAME=Admin
# Optional override for main admin / superadmin handling
# If empty, BOOTSTRAP_ADMIN_EMAIL is used as superadmin
SUPERADMIN_EMAIL=
SUPERADMIN_EMAILS=
MAIN_ADMIN_EMAIL=

# Dashboard refresh interval (ms)
DASHBO_DATA_REFRESH_MS=60000

# Todo list name (e.g. for Outlook tasks integration)
TODO_LIST_NAME=Dashbo

# Outlook Kalender (privat, pro User, nur anzeigen)
# Redirect URI (docker/nginx): http://localhost:8080/api/outlook/callback
OUTLOOK_TENANT=consumers
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:8080/api/outlook/callback
OUTLOOK_SCOPES=offline_access Calendars.Read User.Read Tasks.ReadWrite

# Optional redirects after OAuth flow
OUTLOOK_SUCCESS_REDIRECT=/settings
OUTLOOK_ERROR_REDIRECT=/settings?outlook=error

# Philips Hue (Bridge v2 API, optional)
# Example bridge URL: https://192.168.178.40
HUE_BRIDGE_URL=
# Application key from Hue bridge (required for API access)
HUE_APP_KEY=
# Optional: set to false for HTTP if your bridge cert setup causes local TLS issues
HUE_ALLOW_SELF_SIGNED=true

# Postgres
POSTGRES_DB=dashbo
POSTGRES_USER=dashbo
POSTGRES_PASSWORD=dashbo
POSTGRES_PORT=5432

# --- Automated DB backups (optional) ---
# The docker-compose.yml contains an optional `db_backup` service (enabled via profile).
# Enable: docker compose --profile backup up -d

# Cron expression for backups inside the container (default: daily 03:00)
DB_BACKUP_CRON=0 3 * * *

# How long to keep backups (in days)
DB_BACKUP_KEEP_DAYS=14

# Filename prefix for backups
DB_BACKUP_PREFIX=dashbo

# Timezone used for cron schedule/log timestamps
TZ=Europe/Berlin

# Optional prebuilt edge image tag (used by pi/win edge compose files)
EDGE_IMAGE=ghcr.io/Hubertoink/dashbo-edge:latest

# Frontend nginx template vars (optional)
# Only needed if your backend is not reachable as http://backend:3000/ inside the Docker network.
# Example (separate backend domain):
# API_PROXY_PASS=https://api.example.com/
# API_PROXY_HOST=api.example.com
# CLIENT_MAX_BODY_SIZE=12m
API_PROXY_PASS=http://backend:3000/
API_PROXY_HOST=backend
CLIENT_MAX_BODY_SIZE=12m

# --- dashbo-edge (Pi/Windows local music + HEOS) ---
# These are used by docker-compose.pi-edge.yml and docker-compose.win-edge.yml.
# Configure the same base URL + token in the DashbO Settings page.

# Required: choose a strong token.
EDGE_TOKEN=

# Optional: host port for Edge (container listens on 8787 internally)
EDGE_PORT=8787

# Optional: allowed origins for browser access (comma-separated)
EDGE_ALLOWED_ORIGINS=https://dashbohub.de

# Optional: external/LAN URL used in stream links for speakers.
# Example Windows/LAN: http://192.168.178.27:8787
# Example Pi/LAN:      http://192.168.178.50:8787
EDGE_PUBLIC_BASE_URL=

# Optional HEOS discovery overrides
# Prefer explicit host(s) in Docker Desktop networks.
# Single host example: HEOS_HOST=192.168.178.60
# Multiple hosts:      HEOS_HOSTS=192.168.178.60,192.168.178.61
# Scan fallback:       HEOS_SCAN_CIDR=192.168.178.0/24
HEOS_HOST=
HEOS_HOSTS=
HEOS_SCAN_CIDR=
HEOS_DISCOVERY_TIMEOUT_MS=5000
HEOS_COMMAND_TIMEOUT_MS=5000
HEOS_SCAN_TIMEOUT_MS=200
HEOS_SCAN_CONCURRENCY=64

# Optional: host directory that gets mounted read-only to /mnt/music
# Windows examples:
#   MUSIC_DIR=C:/Users/<you>/Music
#   MUSIC_DIR=C:/Users/<you>/Musik
# Pi/Linux example:
#   MUSIC_DIR=/mnt/music
MUSIC_DIR=
